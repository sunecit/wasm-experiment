{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "paths": {
      "@stand/shared-runtime": [
        "./sut/runtime/shared-runtime.ts"
      ]
    }
  },
  "include": [
    "sut/**/*.ts"
  ]
}
